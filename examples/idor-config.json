{
  "_comment": "Example authz-differ job. Replace the session cookies with your OWN test accounts on a target you are AUTHORIZED to test, then: authz-differ run --config idor-config.json --i-am-authorized",
  "request": {
    "method": "GET",
    "url": "https://api.example.com/api/v1/accounts/{{ID}}",
    "headers": {
      "Accept": "application/json"
    },
    "body": null
  },
  "identities": [
    {
      "name": "owner",
      "role": "owner",
      "id": "1001",
      "headers": { "Cookie": "session=REPLACE_WITH_OWNER_SESSION" }
    },
    {
      "name": "attacker",
      "role": "other",
      "headers": { "Cookie": "session=REPLACE_WITH_ANOTHER_USER_SESSION" }
    },
    {
      "name": "unauthenticated",
      "role": "unauth",
      "headers": {}
    }
  ],
  "settings": {
    "delay": 1.0,
    "similarity_threshold": 0.9,
    "timeout": 20
  }
}
